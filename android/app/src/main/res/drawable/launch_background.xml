<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Gradient background: topRight(#0B5F7A) → bottomLeft(#1D91C0) matching Flutter splash -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#0B5F7A"
                android:centerColor="#0E7490"
                android:endColor="#1D91C0" />
        </shape>
    </item>
    <!-- Centered logo with rounded corners -->
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash" />
    </item>
</layer-list>
